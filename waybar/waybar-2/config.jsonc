
{
    "layer": "top",
    "width": 1700,
    "position": "top",
    "margin": "8 8 0 8",
    "height": 34,
    "spacing": 6,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "cpu",
        "memory",
        "custom/japanese"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpris",
        "network",
        "pulseaudio",
        "battery",
        "tray"
    ],
    
    "mpris": {
    "player": "tauon",
    "format": "♫ {title} — {artist}",
    "format-paused": "Ⅱ {title} — {artist}",
    "max-length": 35,
    "tooltip": true,
    "on-click": "play-pause",
    "on-click-middle": "previous",
    "on-click-right": "next"
},

    "custom/japanese": {
    "format": "「七転び八起き」(Nanakorobi yaoki)",
    "tooltip": false
    },

    "custom/arch": {
    "format": "",
    "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip": false
    },

"network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤭  Disconnected",
    "tooltip-format": "{ifname} → {essid}",
    "interval": 5
},

"pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "Volume: {volume}%"
},

"battery": {
    "interval": 10,

    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󰚥  {capacity}%",
    "format-full": "󰁹  {capacity}%",

    "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
    ],

    "states": {
        "warning": 30,
        "critical": 15
    }
}

}
